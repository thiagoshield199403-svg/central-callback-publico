# Copie para gateway\.env e preencha. O arquivo .env NUNCA deve ser enviado ao GitHub nem colocado na pasta publicada.
# Iniciar: node --env-file=gateway\.env gateway\servidor.mjs
#
# simulacao = nao entrega nada (padrao) | producao = envia pela WhatsApp Cloud API
WHATSAPP_MODO=producao
WHATSAPP_TOKEN=coloque_aqui_o_token_de_usuario_do_sistema
WHATSAPP_PHONE_NUMBER_ID=coloque_aqui_o_id_do_numero
# Use a versao vigente indicada na documentacao da Meta
WHATSAPP_API_VERSAO=vXX.X
# GATEWAY_PORTA=8787
# Identificacao deste polo (cada polo roda o seu gateway, com o seu numero)
# GATEWAY_POLO=Aracaju
# WHATSAPP_NUMERO_ROTULO=WhatsApp Aracaju
#
# Google Drive (OAuth, acesso restrito ao que o app cria). Prefira gerar estas linhas com:
#   node gateway\importar-credencial-google.mjs "caminho\client_secret_....json"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ESCOPO=https://www.googleapis.com/auth/drive.file
# Autorizar depois: node --env-file=gateway\.env gateway\autorizar-drive.mjs
